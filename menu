<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>La Nueva Esmeralda - Menú Digital</title>
    <style>
        :root {
            --bg-color: #0f171e;
            --card-bg: #1b2631;
            --accent-gold: #d4af37;
            --text-light: #f4f4f9;
            --text-muted: #a0aab2;
            --border-color: #2c3e50;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            padding-bottom: 40px;
        }

        header {
            text-align: center;
            padding: 30px 15px 20px;
            background: linear-gradient(180deg, #1b2631 0%, #0f171e 100%);
            border-bottom: 2px solid var(--accent-gold);
        }

        header h1 {
            color: var(--accent-gold);
            font-size: 2.2rem;
            font-family: 'Georgia', serif;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        header p {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .info-bar {
            background-color: var(--card-bg);
            padding: 10px 15px;
            margin: 15px auto;
            max-width: 800px;
            border-radius: 8px;
            font-size: 0.85rem;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-around;
            gap: 10px;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 15px;
        }

        .category-title {
            color: var(--accent-gold);
            font-size: 1.4rem;
            margin: 25px 0 15px;
            padding-bottom: 5px;
            border-bottom: 1px solid var(--accent-gold);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 12px;
        }

        .item-card {
            background-color: var(--card-bg);
            padding: 12px 16px;
            border-radius: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-left: 3px solid var(--accent-gold);
        }

        .item-details {
            padding-right: 10px;
        }

        .item-name {
            font-weight: 600;
            font-size: 0.95rem;
        }

        .item-desc {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 3px;
        }

        .item-price {
            font-weight: bold;
            color: var(--accent-gold);
            white-space: nowrap;
            font-size: 1rem;
        }

        .footer {
            text-align: center;
            margin-top: 30px;
            padding: 20px;
            font-size: 0.8rem;
            color: var(--text-muted);
            border-top: 1px solid var(--border-color);
        }

        .footer a {
            color: var(--accent-gold);
            text-decoration: none;
        }
    </style>
</head>
